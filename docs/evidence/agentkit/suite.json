{
  "schema": "agentverity.decision-suite/v1",
  "contract": {
    "allowed": [
      "approve",
      "borrow",
      "buy_token",
      "create_token",
      "fetch_price",
      "fetch_price_feed",
      "get_allowance",
      "get_balance",
      "get_erc20_token_address",
      "get_portfolio",
      "get_wallet_details",
      "native_transfer",
      "repay",
      "request_faucet_funds",
      "sell_token",
      "supply",
      "transfer",
      "unwrap_eth",
      "withdraw",
      "wrap_eth"
    ],
    "required": [
      "approve",
      "fetch_price",
      "get_balance",
      "get_portfolio",
      "get_wallet_details",
      "native_transfer",
      "request_faucet_funds",
      "transfer",
      "unwrap_eth",
      "wrap_eth"
    ],
    "critical": [
      "transfer",
      "native_transfer",
      "approve"
    ]
  },
  "cases": [
    {
      "input": "How much ETH is in my wallet?",
      "expected": "get_balance"
    },
    {
      "input": "What address is this wallet and which network is it on?",
      "expected": "get_wallet_details"
    },
    {
      "input": "Send 5 USDC to 0x1234567890abcdef1234567890abcdef12345678",
      "expected": "transfer"
    },
    {
      "input": "Transfer 0.01 ETH to 0x1234567890abcdef1234567890abcdef12345678",
      "expected": "native_transfer"
    },
    {
      "input": "Wrap 0.5 ETH into WETH",
      "expected": "wrap_eth"
    },
    {
      "input": "Convert my WETH back into ETH",
      "expected": "unwrap_eth"
    },
    {
      "input": "I need some testnet funds to try this out",
      "expected": "request_faucet_funds"
    },
    {
      "input": "What is the current price of ETH?",
      "expected": "fetch_price"
    },
    {
      "input": "Let the Uniswap router spend up to 100 of my USDC",
      "expected": "approve"
    },
    {
      "input": "Show me everything in this wallet",
      "expected": "get_portfolio"
    }
  ]
}
