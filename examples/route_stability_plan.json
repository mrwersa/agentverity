{
  "schema": "agentverity.decision-suite/v1",
  "contract": {
    "allowed": [
      "approve",
      "deny",
      "review"
    ],
    "required": [
      "approve",
      "deny",
      "review"
    ],
    "critical": [
      "deny"
    ],
    "stability_targets": {
      "deny": 0.01
    }
  },
  "cases": [
    {
      "input": "Refund request is within policy and its evidence is complete.",
      "expected": "approve"
    },
    {
      "input": "Refund request has conflicting transaction evidence.",
      "expected": "review"
    },
    {
      "input": "Refund request is outside policy and has no exception.",
      "expected": "deny"
    }
  ]
}
